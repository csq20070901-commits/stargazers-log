#include<bits/stdc++.h>

using namespace std;

const int N = 105;
struct Node
{
    int m, v;
}a[N];

//按单位价值从大到小排序
bool cmp(Node x, Node y)
{
    return 1.0 * x.v / x.m > 1.0 * y.v / y.m;
}

int main()
{
    int n, T;
    cin >> n >> T;
    for(int i = 1; i <= n; i++)
    {
        cin >> a[i].m >> a[i].v;
    }
    sort(a + 1, a + 1 + n, cmp);
    
    double ans = 0;
    int rest = T;
    for(int i = 1; i <= n; i++)
    {
        if(rest >= a[i].m)
        {
            ans += a[i].v;
            rest -= a[i].m;
        }
        else
        {
            ans += 1.0 * rest / a[i].m * a[i].v;
            rest = 0;
            break;
        }
    }
    printf("%.2f",ans);
    return 0;
}